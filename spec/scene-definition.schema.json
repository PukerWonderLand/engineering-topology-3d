{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pukerwonderland.github.io/engineering-topology-3d/schema/scene-definition-2.0.json",
  "title": "Engineering Topology 3D SceneDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "description", "evidence", "locales", "zones", "nodes", "edges", "journeys", "functions", "layout", "enhanced"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "supported"],
      "properties": {
        "default": { "enum": ["zh-CN", "en-US"] },
        "supported": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["zh-CN", "en-US"] } }
      }
    },
    "zones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/zone" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "journeys": { "type": "array", "items": { "$ref": "#/$defs/journey" } },
    "functions": { "type": "array", "items": { "$ref": "#/$defs/function" } },
    "layout": { "$ref": "#/$defs/layout" },
    "enhanced": { "$ref": "#/$defs/enhanced" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "vector3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zhCN", "enUS"],
      "properties": { "zhCN": { "type": "string", "minLength": 1 }, "enUS": { "type": "string", "minLength": 1 } }
    },
    "evidence": { "enum": ["CODE_PROVEN", "RTL_PROVEN", "RUNTIME_OBSERVED", "INFERRED"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "note"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "note": { "type": "string", "minLength": 1 }, "line": { "type": "integer", "minimum": 1 } }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "eyebrow", "summary", "color", "nodeIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "eyebrow": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "nodeIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "zoneId", "title", "description", "kind", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "zoneId": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "eyebrow": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["actor", "application", "service", "driver", "protocol", "buffer", "device", "hardware", "data", "state"] }, "evidence": { "$ref": "#/$defs/evidence" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "tags": { "type": "array", "items": { "type": "string" } }, "interfaces": { "type": "array", "items": { "type": "string" } }, "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "title", "description", "kind", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "source": { "$ref": "#/$defs/id" }, "target": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["payload", "control", "sync", "lifecycle", "physical"] }, "evidence": { "$ref": "#/$defs/evidence" }, "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "lane": { "type": "string" }, "protocol": { "type": "string" }, "dashed": { "type": "boolean" }
      }
    },
    "journeyStep": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "evidence"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "nodeId": { "$ref": "#/$defs/id" }, "functionId": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "evidence": { "$ref": "#/$defs/evidence" } },
      "anyOf": [
        { "properties": { "nodeId": { "$ref": "#/$defs/id" } }, "required": ["nodeId"] },
        { "properties": { "functionId": { "$ref": "#/$defs/id" } }, "required": ["functionId"] }
      ]
    },
    "journey": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "steps", "edgeIds"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" }, "caveat": { "$ref": "#/$defs/text" }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/journeyStep" } }, "edgeIds": { "type": "array", "items": { "$ref": "#/$defs/id" } } }
    },
    "contract": {
      "type": "object", "additionalProperties": false, "required": ["trigger", "context", "consumes", "produces", "stateResource", "completionError"],
      "properties": { "trigger": { "type": "string" }, "context": { "type": "string" }, "consumes": { "type": "string" }, "produces": { "type": "string" }, "stateResource": { "type": "string" }, "completionError": { "type": "string" }, "hardwareEffect": { "type": "string" } }
    },
    "function": {
      "type": "object", "additionalProperties": false, "required": ["id", "moduleId", "name", "description", "evidence", "contract"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "moduleId": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "evidence": { "$ref": "#/$defs/evidence" }, "contract": { "$ref": "#/$defs/contract" }, "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } } }
    },
    "nodeLayout": {
      "type": "object", "additionalProperties": false, "required": ["nodeId", "position", "size"],
      "properties": { "nodeId": { "$ref": "#/$defs/id" }, "position": { "$ref": "#/$defs/vector3" }, "size": { "$ref": "#/$defs/vector3" }, "labelOffset": { "$ref": "#/$defs/vector3" }, "moduleSide": { "enum": ["left", "right"] }, "cameraSide": { "enum": ["left", "right"] } }
    },
    "zoneLayout": {
      "type": "object", "additionalProperties": false, "required": ["zoneId", "position", "size"],
      "properties": { "zoneId": { "$ref": "#/$defs/id" }, "position": { "$ref": "#/$defs/vector3" }, "size": { "$ref": "#/$defs/vector3" }, "backdrop": { "enum": ["generic", "server", "board", "fabric", "device"] } }
    },
    "camera": {
      "type": "object", "additionalProperties": false, "required": ["position", "target"],
      "properties": { "position": { "$ref": "#/$defs/vector3" }, "target": { "$ref": "#/$defs/vector3" }, "fov": { "type": "number", "minimum": 10, "maximum": 120 } }
    },
    "layout": {
      "type": "object", "additionalProperties": false, "required": ["nodes", "zones", "camera"],
      "properties": { "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nodeLayout" } }, "zones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/zoneLayout" } }, "camera": { "$ref": "#/$defs/camera" }, "labelDistance": { "type": "number", "minimum": 0 }, "farBlockOpacity": { "type": "number", "minimum": 0, "maximum": 1 }, "farFlowOpacity": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "enhancedLocaleContent": {
      "type": "object",
      "required": ["planeMeta", "edgeMeta", "laneMeta", "functionInteractions", "driverCausalLayerMeta", "driverJourneyRelationMeta", "driverJourneys", "topologyNodes", "topologyEdges", "viewOptions", "systemTree", "storageTrees", "runtimeFacts", "cameraHudViews"],
      "properties": {
        "planeMeta": { "type": "object" },
        "edgeMeta": { "type": "object" },
        "laneMeta": { "type": "object" },
        "functionInteractions": { "type": "object" },
        "driverCausalLayerMeta": { "type": "object" },
        "driverJourneyRelationMeta": { "type": "object" },
        "driverJourneys": { "type": "object", "minProperties": 1 },
        "topologyNodes": { "type": "array", "minItems": 1 },
        "topologyEdges": { "type": "array" },
        "viewOptions": { "type": "array", "minItems": 1 },
        "systemTree": { "type": "array", "minItems": 1 },
        "storageTrees": { "type": "array" },
        "runtimeFacts": { "type": "array" },
        "cameraHudViews": { "type": "object", "minProperties": 1 }
      }
    },
    "enhanced": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultView", "content", "common", "displayDefaults"],
      "properties": {
        "defaultView": { "$ref": "#/$defs/id" },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zhCN", "enUS"],
          "properties": {
            "zhCN": { "$ref": "#/$defs/enhancedLocaleContent" },
            "enUS": { "$ref": "#/$defs/enhancedLocaleContent" }
          }
        },
        "common": {
          "type": "object",
          "additionalProperties": false,
          "required": ["focusModuleGroups", "driverJourneyModuleRoleByNodeId", "driverJourneyOrder", "nodePositions", "macroZones", "globalModuleLabels", "routeNodeIds", "directionCards", "visuals"],
          "properties": {
            "focusModuleGroups": { "type": "object" },
            "driverJourneyModuleRoleByNodeId": { "type": "object" },
            "driverJourneyOrder": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "nodePositions": { "type": "object", "minProperties": 1 },
            "macroZones": { "type": "object", "minProperties": 1 },
            "globalModuleLabels": { "type": "array", "minItems": 1 },
            "routeNodeIds": { "type": "object", "minProperties": 1 },
            "directionCards": { "type": "array" },
            "visuals": {
              "type": "object",
              "additionalProperties": false,
              "required": ["zones", "modules", "layers", "depths"],
              "properties": {
                "zones": { "type": "array", "minItems": 1 },
                "modules": { "type": "array", "minItems": 1 },
                "layers": { "type": "array" },
                "depths": { "type": "array" }
              }
            }
          }
        },
        "displayDefaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pipeThickness", "hudDistance", "moduleLabelDistance", "labelLayoutMode", "labelLineThickness", "moduleLabelScale", "focusAnnotationScale", "focusHudTextScale", "subLabelDistance", "subLabelFadeRange", "farFadeStart", "farBlockOpacity", "farFlowOpacity"],
          "properties": {
            "pipeThickness": { "type": "number", "minimum": 1, "maximum": 6 },
            "hudDistance": { "type": "number", "minimum": 0.6, "maximum": 2.4 },
            "moduleLabelDistance": { "type": "number", "minimum": 0.6, "maximum": 2.4 },
            "labelLayoutMode": { "enum": ["module", "camera"] },
            "labelLineThickness": { "type": "number", "minimum": 0.5, "maximum": 6 },
            "moduleLabelScale": { "type": "number", "minimum": 0.6, "maximum": 1.6 },
            "focusAnnotationScale": { "type": "number", "minimum": 0.6, "maximum": 1.6 },
            "focusHudTextScale": { "type": "number", "minimum": 0.8, "maximum": 1.8 },
            "subLabelDistance": { "type": "number", "minimum": 10, "maximum": 70 },
            "subLabelFadeRange": { "type": "number", "minimum": 2, "maximum": 20 },
            "farFadeStart": { "type": "number", "minimum": 15, "maximum": 100 },
            "farBlockOpacity": { "type": "number", "minimum": 0.08, "maximum": 0.8 },
            "farFlowOpacity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
